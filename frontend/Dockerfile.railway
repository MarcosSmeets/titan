# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install

COPY . .

# Railway injects VITE_API_URL at build time so the frontend
# knows where the API lives (e.g. https://titan-api-production.up.railway.app)
ARG VITE_API_URL=""
ENV VITE_API_URL=${VITE_API_URL}

RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Copy template that uses $PORT (Railway provides this at runtime)
COPY nginx.railway.conf /etc/nginx/templates/default.conf.template

COPY --from=builder /app/dist /usr/share/nginx/html

# Railway assigns a random port via $PORT
ENV PORT=80

EXPOSE ${PORT}

# envsubst replaces ${PORT} in the template, then nginx starts
CMD ["sh", "-c", "envsubst '${PORT}' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
